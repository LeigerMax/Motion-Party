  m_Script: {fileID: 11500000, guid: e7b0d6ba7e0823b40abc2e375cbf2f26, type: 3}
  m_Name: EncouragementConfig_firefly
  m_EditorClassIdentifier: 
  configurationName: "Configuration par d\xE9faut"
  description: Description de cette configuration de messages
  messages:
  - text: Tu les attrapes comme un pro !
    audioClip: {fileID: 8300000, guid: 255e9aa26c622dc438511983bb14680d, type: 3}
    displayDuration: 4
    messageId: b1c336b3-6077-4856-9d18-5e4231f1ff28
  - text: 'Une de plus dans le filet ! '
    audioClip: {fileID: 8300000, guid: eb499c6cce4ec4b4c887b9b13139a497, type: 3}
    displayDuration: 4
    messageId: b1c336b3-6077-4856-9d18-5e4231f1ff27
  - text: "Vise bien, elle ne t\u2019\xE9chappera pas"
    audioClip: {fileID: 8300000, guid: e978cc06c6f145747923c06e45dc3f28, type: 3}
    displayDuration: 4
    messageId: b1c336b3-6077-4856-9d18-5e4231f1ff26
  - text: "C\u2019\xE9tait pr\xE9cis, bravo !"
    audioClip: {fileID: 8300000, guid: 558bd7911dc090749a0c661d8b7d04d3, type: 3}
    displayDuration: 4
    messageId: b1c336b3-6077-4856-9d18-5e4231f1ff25
  - text: Attention, celle-ci est rapide !
    audioClip: {fileID: 8300000, guid: 2a87f1468cfe78f46b931b8bee17b04a, type: 3}
    displayDuration: 4
    messageId: b1c336b3-6077-4856-9d18-5e4231f1ff24
  - text: "Elles ne peuvent plus t\u2019\xE9chapper ! "
    audioClip: {fileID: 8300000, guid: 138020258db7caf478a6348c24ed2409, type: 3}
    displayDuration: 4
    messageId: b1c336b3-6077-4856-9d18-5e4231f1ff23
  - text: "Bien jou\xE9, elle n\u2019a rien vu venir ! "
    audioClip: {fileID: 8300000, guid: f45a3ccd08ca871479cfeec75c0c3845, type: 3}
    displayDuration: 4
    messageId: b1c336b3-6077-4856-9d18-5e4231f1ff22
  - text: "Encore une et c\u2019est la gloire du camp !"
    audioClip: {fileID: 8300000, guid: e300e060dadf2994eb55ac70353a8bde, type: 3}
    displayDuration: 4
    messageId: b1c336b3-6077-4856-9d18-5e4231f1ff21
  minInterval: 10
  maxInterval: 15
  defaultDisplayDuration: 3
  audioVolume: 3
  playAudioWithMessage: 1
