  configurationName: "Configuration par d\xE9faut"
  description: Description de cette configuration de messages
  messages:
  - text: Hop, un rondin de plus !
    audioClip: {fileID: 8300000, guid: 28e5d96a0348432468e2f09443aea9b4, type: 3}
    displayDuration: 4
    messageId: 91357c23-21cf-4d1b-8a60-d5a84549b9851
  - text: "Belle travers\xE9e, continue !"
    audioClip: {fileID: 8300000, guid: 54ceb3dc2cd768e428e6e80507cb0b10, type: 3}
    displayDuration: 4
    messageId: 91357c23-21cf-4d1b-8a60-d5a84549b9850
  - text: "Tu es agile comme un \xE9cureuil !"
    audioClip: {fileID: 8300000, guid: 9bd1eff573712794382a2c274b579aa4, type: 3}
    displayDuration: 4
    messageId: 91357c23-21cf-4d1b-8a60-d5a84549b9849
  - text: "Les copains sur la berge t\u2019applaudissent !"
    audioClip: {fileID: 8300000, guid: 487aba18215b5494d9b0325d7d9c833b, type: 3}
    displayDuration: 4
    messageId: 91357c23-21cf-4d1b-8a60-d5a84549b9848
  - text: "Cette rivi\xE8re est \xE0 toi ! "
    audioClip: {fileID: 8300000, guid: a57253d06ef59544db7eacad774291fb, type: 3}
    displayDuration: 4
    messageId: 91357c23-21cf-4d1b-8a60-d5a84549b9847
