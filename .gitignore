# Ce fichier .gitignore est adapté pour un projet Unity + Muse + Python (backend tracker)

# -------------------------
# UNITY - Dossiers temporaires
# -------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Specific Unity paths (pour forcer l'ignorance de fichiers déjà trackés)
Motion-Party/Library/
Motion-Party/Temp/
Motion-Party/Logs/
Motion-Party/UserSettings/
Motion-Party/MemoryCaptures/
Motion-Party/Recordings/

# Shader cache
/[Ll]ibrary/ShaderCache/
Motion-Party/Library/ShaderCache/

# -------------------------
# UNITY - IDEs & métadonnées
# -------------------------
.vs/
.gradle/
.consulo/
.vscode/

# VS / JetBrains files
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity meta files inutiles
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Fichier de rapport de crash Unity
sysinfo.txt

# -------------------------
# UNITY - Plugins spécifiques
# -------------------------
/[Aa]ssets/Plugins/Editor/JetBrains*
# /[Aa]ssets/AssetStoreTools*  # À décommenter si utilisé

# -------------------------
# UNITY - Builds et paquets
# -------------------------
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
crashlytics-build.properties

# -------------------------
# UNITY - Addressables & StreamingAssets
# -------------------------
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# -------------------------
# UNITY - Muse / PackageCache
# -------------------------
Packages/com.unity.muse.*
PackagesCache/com.unity.muse.*

# -------------------------
# PYTHON - Fichiers à ignorer
# -------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
.env
.venv/
env/
venv/
*.log

# -------------------------
# DONNÉES LOURDES - Tracker ou autre
# -------------------------
python-tracker/quickdraw_data/
python-tracker/reference_drawings/

# -------------------------
# FICHIERS SYSTÈME
# -------------------------
.DS_Store
Thumbs.db
desktop.ini

